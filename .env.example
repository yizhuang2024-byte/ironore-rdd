# ── 資料庫 ──────────────────────────────────────────────
DATABASE_URL="postgresql://ltc:ltc@localhost:5432/ltc_dev"

# ── 個資加密金鑰（個資法要求；務必以 openssl rand -base64 32 產生）──
# 用於身分證字號、地址、病史等欄位的 AES-256-GCM 加密
PII_ENCRYPTION_KEY=""
# 用於 blind index（HMAC-SHA256），供加密欄位的唯一性檢查與精確查詢
PII_INDEX_KEY=""

# ── Session ─────────────────────────────────────────────
SESSION_SECRET=""

# ── 伺服器 ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# 全系統一律以 UTC 儲存，僅顯示層轉 Asia/Taipei
TZ=UTC
CORS_ORIGIN="http://localhost:5173"

# ── 前端 ────────────────────────────────────────────────
VITE_API_BASE_URL="http://localhost:3000/api/v1"
