{
  "name": "ltc-care",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ltc/api --filter @ltc/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @ltc/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @ltc/api db:migrate:deploy",
    "db:reset": "pnpm --filter @ltc/api db:reset",
    "db:seed": "pnpm --filter @ltc/api db:seed",
    "db:studio": "pnpm --filter @ltc/api db:studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "@prisma/client"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
